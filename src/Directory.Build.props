<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NetEscapades.EnumGenerators.Generators uses DescriptionAttribute to generate the enum values -->
    <EnumGenerator_EnumMetadataSource>DescriptionAttribute</EnumGenerator_EnumMetadataSource>
  </PropertyGroup>

  <PropertyGroup>
    <BunVersion>1.3.6</BunVersion>
    <BunDotNetVersion>1.2.0</BunDotNetVersion>
    <!--
      Use local tool-manifest resolution to keep BunDotNet.Cli runnable offline after an initial
      `dotnet tool restore`. This avoids querying NuGet on every build as `dotnet tool exec` does.
    -->
    <BunWrapper>dotnet tool run BunDotNet.Cli -- wrapper --version $(BunVersion) --path ../../tools --silent --</BunWrapper>
  </PropertyGroup>
</Project>
