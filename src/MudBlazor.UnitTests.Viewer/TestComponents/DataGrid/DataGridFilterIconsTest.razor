<MudPopoverProvider />

<MudDataGrid T="Model" Items="@_items" Filterable="true" FilterMode="FilterMode"
             SortIcon="test_sort_icon"
             FilterIconEmpty="test_filter_empty_icon" FilterIconFilled="test_filter_filled_icon" FilterIconClear="test_filter_clear_icon"
             ColumnOptionsIcon="test_column_options_icon"
             ShowMenuIcon="@ShowMenuIcon" ShowColumnOptions="@ShowColumnOptions" ColumnsPanelReordering="true" Groupable="true">
    <Columns>
        <PropertyColumn Property="x => x.Name" Grouping="true" />
        <PropertyColumn Property="x => x.Age" />
    </Columns>
</MudDataGrid>

@code {
    public record Model(string Name, int Age);

    [Parameter]
    public DataGridFilterMode FilterMode { get; set; } = DataGridFilterMode.Simple;

    [Parameter]
    public bool ShowMenuIcon { get; set; }

    [Parameter]
    public bool ShowColumnOptions { get; set; } = true;

    private readonly IEnumerable<Model> _items = new List<Model>()
    {
        new("Sam", 56),
        new("Alicia", 54),
        new("Ira", 27),
        new("John", 32)
    };
}
