+﻿using System;
+using System.Threading.Tasks;
+
+namespace MudBlazor.Utilities
+{
+    internal static class TaskChain
+    {
+        public static async Task ThenAsync(Task first, Func<Task> next)
+        {
+            await first;
+            await next();
+        }
+    }
+}
