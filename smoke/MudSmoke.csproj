<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Mono full AOT like the reporter's app (techscex/MudBlazorTestOne); pass -p:MtouchInterpreter=all for the control. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MudSmoke</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationTitle>MudBlazor AOT smoke</ApplicationTitle>
    <ApplicationId>com.example.mudsmoke</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <PublishAot>false</PublishAot>
    <UseInterpreter>false</UseInterpreter>
    <MtouchInterpreter></MtouchInterpreter>
    <MtouchUseLlvm>false</MtouchUseLlvm>
    <MtouchLink>SdkOnly</MtouchLink>
    <MudBlazorVersion Condition="'$(MudBlazorVersion)' == ''">9.12.0</MudBlazorVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="NuGet.Config;global.json" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.120" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="$(MudBlazorVersion)" />
  </ItemGroup>
</Project>
