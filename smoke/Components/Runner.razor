@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<p id="smoke-status">@_status</p>
@if (_case is not null)
{
    <SmokeBoundary @key="_index" OnError="OnCaseError">
        <div id="smoke-case">@_case.Value.Content</div>
    </SmokeBoundary>
}

@code {
    // Read by the logger provider so renderer errors land on the case that caused them.
    public static int CurrentIndex { get; private set; } = -1;

    private readonly List<(string Name, RenderFragment Content)> _cases = [];
    private (string Name, RenderFragment Content)? _case;
    private int _index = -1;
    private string _status = "starting";
    private string? _error;

    private int _int = 1;
    private int? _nullableInt;
    private double _double = 1;
    private decimal _decimal = 1;
    private long _long = 1;
    private bool _bool;
    private bool? _nullableBool;
    private string? _text = "text";
    private Color _enum = Color.Primary;
    private IReadOnlyCollection<string>? _strings = ["one"];
    private DateTime? _date = new DateTime(2026, 11, 6);
    private DateRange _dateRange = new(new DateTime(2026, 11, 1), new DateTime(2026, 11, 6));
    private TimeSpan? _time = new TimeSpan(9, 30, 0);
    private MudColor _color = new("#594ae2");
    private int _rating = 2;
    private int _page = 1;
    private bool _open = true;
    private Range<int> _range = new(1, 5);
    private readonly int[] _ints = Enumerable.Range(1, 50).ToArray();
    private readonly List<Row> _rows =
    [
        new() { Id = 1, Name = "Anchor", Price = 9.5m, Added = new DateTime(2026, 1, 2), Active = true, Zone = "a" },
        new() { Id = 2, Name = "Bolt", Price = 1.25m, Added = new DateTime(2026, 3, 4), Zone = "b" },
        new() { Id = 3, Name = "Clamp", Price = 4m, Added = new DateTime(2026, 5, 6), Active = true, Zone = "a" },
    ];
    private readonly List<ChartSeries<double>> _doubleSeries = [new() { Name = "Sales", Data = new double[] { 3, 5, 2, 8 } }];
    private readonly List<ChartSeries<int>> _intSeries = [new() { Name = "Units", Data = new int[] { 4, 1, 6, 3 } }];
    private readonly string[] _labels = ["Q1", "Q2", "Q3", "Q4"];

    protected override void OnInitialized()
    {
        // Value-type generics first: those run as shared generic code under Mono full AOT.
        Add("slider-int", @<MudSlider T="int" @bind-Value="_int" Max="360">Hue</MudSlider>);
        Add("slider-double", @<MudSlider T="double" @bind-Value="_double" Max="360">Angle</MudSlider>);
        Add("colorpicker-static", @<MudColorPicker @bind-Value="_color" PickerVariant="PickerVariant.Static" />);
        Add("numeric-int", @<MudNumericField T="int" @bind-Value="_int" Label="Count" />);
        Add("numeric-double", @<MudNumericField T="double" @bind-Value="_double" Label="Amount" />);
        Add("numeric-decimal", @<MudNumericField T="decimal" @bind-Value="_decimal" Label="Price" />);
        Add("numeric-long", @<MudNumericField T="long" @bind-Value="_long" Label="Big" />);
        Add("numeric-nullable-int", @<MudNumericField T="int?" @bind-Value="_nullableInt" Label="Optional" />);
        Add("textfield-int", @<MudTextField T="int" @bind-Value="_int" Label="Whole number" />);
        Add("textfield-string", @<MudTextField T="string" @bind-Value="_text" Label="Name" />);
        Add("textfield-mask", @<MudTextField T="string" @bind-Value="_text" Mask="@(new PatternMask("0000"))" Label="PIN" />);
        Add("select-int", @<MudSelect T="int" @bind-Value="_int" Label="Size">
                                <MudSelectItem T="int" Value="1">Small</MudSelectItem>
                                <MudSelectItem T="int" Value="2">Large</MudSelectItem>
                            </MudSelect>);
        Add("select-enum", @<MudSelect T="Color" @bind-Value="_enum" Label="Color">
                                 <MudSelectItem T="Color" Value="Color.Primary">Primary</MudSelectItem>
                                 <MudSelectItem T="Color" Value="Color.Error">Error</MudSelectItem>
                             </MudSelect>);
        Add("select-multi-string", @<MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_strings" Label="Tags">
                                         <MudSelectItem T="string" Value="@("one")">One</MudSelectItem>
                                         <MudSelectItem T="string" Value="@("two")">Two</MudSelectItem>
                                     </MudSelect>);
        Add("autocomplete-int", @<MudAutocomplete T="int" @bind-Value="_int" SearchFunc="SearchIntsAsync" Label="Find" />);
        Add("checkbox-bool", @<MudCheckBox T="bool" @bind-Value="_bool" Label="Agree" />);
        Add("checkbox-nullable-bool", @<MudCheckBox T="bool?" @bind-Value="_nullableBool" TriState="true" Label="Maybe" />);
        Add("switch-bool", @<MudSwitch T="bool" @bind-Value="_bool" Label="Enabled" />);
        Add("radio-int", @<MudRadioGroup T="int" @bind-Value="_int">
                              <MudRadio T="int" Value="1">Small</MudRadio>
                              <MudRadio T="int" Value="2">Large</MudRadio>
                          </MudRadioGroup>);
        Add("togglegroup-int", @<MudToggleGroup T="int" @bind-Value="_int">
                                    <MudToggleItem T="int" Value="1" Text="Day" />
                                    <MudToggleItem T="int" Value="2" Text="Week" />
                                </MudToggleGroup>);
        Add("chipset-int", @<MudChipSet T="int" @bind-SelectedValue="_int" SelectionMode="SelectionMode.SingleSelection">
                                <MudChip T="int" Value="1" Text="Red" />
                                <MudChip T="int" Value="2" Text="Blue" />
                            </MudChipSet>);
        Add("list-int", @<MudList T="int" @bind-SelectedValue="_int">
                             <MudListItem T="int" Value="1" Text="Inbox" />
                             <MudListItem T="int" Value="2" Text="Sent" />
                         </MudList>);
        Add("treeview-int", @<MudTreeView T="int" @bind-SelectedValue="_int">
                                 <MudTreeViewItem T="int" Value="1" Text="Documents">
                                     <MudTreeViewItem T="int" Value="2" Text="Report" />
                                 </MudTreeViewItem>
                             </MudTreeView>);
        Add("rangeinput-int", @<MudRangeInput T="int" @bind-Value="_range" />);
        Add("chart-line-double", @<MudChart T="double" ChartType="ChartType.Line" ChartSeries="_doubleSeries" ChartLabels="_labels" Width="300px" Height="200px" />);
        Add("chart-bar-int", @<MudChart T="int" ChartType="ChartType.Bar" ChartSeries="_intSeries" ChartLabels="_labels" Width="300px" Height="200px" />);
        Add("chart-pie-int", @<MudChart T="int" ChartType="ChartType.Pie" ChartSeries="_intSeries" ChartLabels="_labels" Width="300px" Height="200px" />);
        Add("datagrid-columns", @<MudDataGrid T="Row" Items="_rows" Filterable="true" SortMode="SortMode.Multiple" Groupable="true">
                                     <Columns>
                                         <PropertyColumn Property="x => x.Id" />
                                         <PropertyColumn Property="x => x.Name" />
                                         <PropertyColumn Property="x => x.Price" />
                                         <PropertyColumn Property="x => x.Added" />
                                         <PropertyColumn Property="x => x.Active" />
                                     </Columns>
                                 </MudDataGrid>);
        Add("datagrid-edit", @<MudDataGrid T="Row" Items="_rows" ReadOnly="false" EditMode="DataGridEditMode.Cell">
                                  <Columns>
                                      <PropertyColumn Property="x => x.Id" />
                                      <PropertyColumn Property="x => x.Price" />
                                  </Columns>
                              </MudDataGrid>);
        Add("table-sort", @<MudTable T="Row" Items="_rows">
                               <HeaderContent>
                                   <MudTh><MudTableSortLabel T="Row" SortBy="x => x.Price">Price</MudTableSortLabel></MudTh>
                               </HeaderContent>
                               <RowTemplate>
                                   <MudTd>@context.Price</MudTd>
                               </RowTemplate>
                           </MudTable>);
        Add("datepicker", @<MudDatePicker @bind-Date="_date" Label="Date" />);
        Add("datepicker-static", @<MudDatePicker @bind-Date="_date" PickerVariant="PickerVariant.Static" />);
        Add("daterangepicker", @<MudDateRangePicker @bind-DateRange="_dateRange" Label="Range" />);
        Add("timepicker-static", @<MudTimePicker @bind-Time="_time" PickerVariant="PickerVariant.Static" />);
        Add("rating", @<MudRating @bind-SelectedValue="_rating" />);
        Add("pagination", @<MudPagination Count="5" @bind-Selected="_page" />);
        Add("virtualize-int", @<div style="height:100px;overflow:auto"><MudVirtualize T="int" Items="_ints" Enabled="true">@context</MudVirtualize></div>);
        Add("dropzone", @<MudDropContainer T="Row" Items="_rows" ItemsSelector="@((item, zone) => item.Zone == zone)">
                             <ChildContent>
                                 <MudDropZone T="Row" Identifier="a" />
                                 <MudDropZone T="Row" Identifier="b" />
                             </ChildContent>
                             <ItemRenderer>@context.Name</ItemRenderer>
                         </MudDropContainer>);

        // Non-generic components, including ones named in MudBlazor#6558.
        Add("drawer", @<MudLayout>
                           <MudDrawer @bind-Open="_open" Variant="DrawerVariant.Temporary">Menu</MudDrawer>
                           <MudMainContent><MudButton OnClick="() => _open = !_open">Toggle</MudButton></MudMainContent>
                       </MudLayout>);
        Add("menu", @<MudMenu Label="Actions"><MudMenuItem>Rename</MudMenuItem><MudMenuItem>Delete</MudMenuItem></MudMenu>);
        Add("tabs", @<MudTabs><MudTabPanel Text="General">One</MudTabPanel><MudTabPanel Text="Advanced">Two</MudTabPanel></MudTabs>);
        Add("expansionpanels", @<MudExpansionPanels><MudExpansionPanel Text="Details">Body</MudExpansionPanel></MudExpansionPanels>);
        Add("stepper", @<MudStepper><MudStep Title="Account">One</MudStep><MudStep Title="Confirm">Two</MudStep></MudStepper>);
        Add("snackbar", @<MudButton OnClick="@(() => Snackbar.Add("Saved", Severity.Success))">Notify</MudButton>);
        Add("tooltip", @<MudTooltip Text="Help"><MudButton>Hover</MudButton></MudTooltip>);
        Add("carousel", @<MudCarousel TData="object" Style="height:100px" AutoCycle="false">
                             <MudCarouselItem>First</MudCarouselItem>
                             <MudCarouselItem>Second</MudCarouselItem>
                         </MudCarousel>);
        Add("form-validation", @<MudForm>
                                    <MudTextField T="string" @bind-Value="_text" Required="true" Label="Required" />
                                    <MudNumericField T="int" @bind-Value="_int" Min="0" Max="10" Label="Range" />
                                </MudForm>);
    }

    private void Add(string name, RenderFragment content) => _cases.Add((name, content));

    private Task<IEnumerable<int>> SearchIntsAsync(string? text, CancellationToken token) =>
        Task.FromResult(_ints.Where(x => text is null || x.ToString().Contains(text)).Take(5));

    private void OnCaseError(Exception exception) => _error ??= Smoke.Describe(exception);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        AppDomain.CurrentDomain.UnhandledException += (_, e) => Smoke.Log("unhandled", CurrentIndex, _case?.Name, Smoke.Describe(e.ExceptionObject as Exception));
        TaskScheduler.UnobservedTaskException += (_, e) => Smoke.Log("unobserved", CurrentIndex, _case?.Name, Smoke.Describe(e.Exception));

        var start = int.TryParse(Environment.GetEnvironmentVariable("SMOKE_START"), out var value) ? value : 0;
        Smoke.Log("begin", start, null, $"{_cases.Count} cases");
        for (var i = start; i < _cases.Count; i++)
        {
            _index = i;
            CurrentIndex = i;
            _case = _cases[i];
            _error = null;
            _status = _case.Value.Name;
            Smoke.Log("start", i, _case.Value.Name);
            StateHasChanged();
            await Task.Delay(400);
            if (_error is null)
            {
                Smoke.Log("rendered", i, _case.Value.Name);
            }

            string poked;
            try
            {
                poked = await JS.InvokeAsync<string>("smoke.poke", "smoke-case");
            }
            catch (Exception exception)
            {
                poked = "poke failed: " + Smoke.Describe(exception);
            }

            await Task.Delay(500);
            Smoke.Log(_error is null ? "ok" : "error", i, _case.Value.Name, _error ?? poked);
        }

        _case = null;
        _status = "done";
        StateHasChanged();
        Smoke.Log("done", _cases.Count, null);
    }
}
